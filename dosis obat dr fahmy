        // POPULATE DATABASE DROPDOWNS
        function initDatabaseDropdowns() {
            const singleSelect = document.getElementById('single-drug-select');
            singleSelect.innerHTML = '';

            const filtered = DRUG_DATABASE.filter(d => {
                if (appState.selectedCategory === 'SEMUA') return true;
                return d.category === appState.selectedCategory;
            });

            if (filtered.length === 0) {
                const opt = document.createElement('option');
                opt.value = "";
                opt.textContent = "Tidak ada obat dalam kategori ini";
                singleSelect.appendChild(opt);
                return;
            }

            filtered.forEach((drug) => {
                const opt = document.createElement('option');
                opt.value = drug.id;
                opt.textContent = `${drug.name} (${drug.category})`;
                singleSelect.appendChild(opt);
            });

            singleSelect.selectedIndex = 0;
            onSingleDrugSelect();
        }

        function filterDrugDropdown() {
            const query = document.getElementById('drug-search').value.toLowerCase();
            const singleSelect = document.getElementById('single-drug-select');
            const clearBtn = document.getElementById('clear-search-btn');

            if (query.length > 0) {
                clearBtn.classList.remove('hidden');
            } else {
                clearBtn.classList.add('hidden');
            }

            singleSelect.innerHTML = '';
            
            let count = 0;
            DRUG_DATABASE.forEach((drug) => {
                if (drug.name.toLowerCase().includes(query) || drug.category.toLowerCase().includes(query)) {
                    const opt = document.createElement('option');
                    opt.value = drug.id;
                    opt.textContent = `${drug.name} (${drug.category})`;
                    singleSelect.appendChild(opt);
                    count++;
                }
            });

            if (count === 0) {
                const opt = document.createElement('option');
                opt.value = "";
                opt.disabled = true;
                opt.textContent = "Obat tidak ditemukan...";
                singleSelect.appendChild(opt);
            } else {
                singleSelect.selectedIndex = 0;
                onSingleDrugSelect();
            }
        }

        function clearDrugSearch() {
            document.getElementById('drug-search').value = '';
            document.getElementById('clear-search-btn').classList.add('hidden');
            initDatabaseDropdowns();
        }

        // ================= LOGIKA TAB 1: DOSIS TUNGGAL OTOMATIS =================
        function onSingleDrugSelect() {
            const drugId = document.getElementById('single-drug-select').value;
            appState.single.drugId = drugId;
            const drug = DRUG_DATABASE.find(d => d.id === drugId);

            if (!drug) return;

            // Populate sediaan dropdown
            const sediaanSelect = document.getElementById('single-sediaan-select');
            sediaanSelect.innerHTML = '';

            drug.sediaan.forEach((s, idx) => {
                const opt = document.createElement('option');
                opt.value = idx;
                const icon = s.type === 'tablet' ? '💊' : (s.type === 'drops' ? '💧' : '🧴');
                opt.textContent = `${icon} ${s.label}`;
                sediaanSelect.appendChild(opt);
            });

            sediaanSelect.selectedIndex = 0;

            // Update read-only info
            document.getElementById('info-dose-std').innerText = `${drug.doseMin === drug.doseMax ? drug.doseMin : drug.doseMin + ' - ' + drug.doseMax} ${drug.unit}`;
            document.getElementById('info-freq-std').innerText = drug.freqText;

            calculateSingleDose();
        }

        function calculateSingleDose() {
            const weight = appState.weight;
            const placeholder = document.getElementById('single-placeholder');
            const resultCard = document.getElementById('single-result-card');

            if (weight <= 0) {
                placeholder.classList.remove('hidden');
                resultCard.classList.add('hidden');
                return;
            }

            const drug = DRUG_DATABASE.find(d => d.id === appState.single.drugId);
            if (!drug) {
                placeholder.classList.remove('hidden');
                resultCard.classList.add('hidden');
                return;
            }

            const sediaanIndex = parseInt(document.getElementById('single-sediaan-select').value) || 0;
            const sediaan = drug.sediaan[sediaanIndex] || drug.sediaan[0];

            // 1. Hitung Dosis mg
            const minMg = weight * drug.doseMin;
            const maxMg = weight * drug.doseMax;
            const targetAvgMg = (minMg + maxMg) / 2;

            // 2. Hitung Fisik (Tablet / mL / drops)
            let physicalMin = 0, physicalMax = 0, physicalTarget = 0;
            let physicalUnitText = '';

            if (sediaan.type === 'tablet') {
                physicalMin = minMg / sediaan.mg;
                physicalMax = maxMg / sediaan.mg;
                physicalTarget = targetAvgMg / sediaan.mg;
                physicalUnitText = sediaan.unitName || 'Tablet';
            } else {
                // Liquid (Sirup / Drops / Dry Syrup)
                physicalMin = (minMg / sediaan.mg) * sediaan.ml;
                physicalMax = (maxMg / sediaan.mg) * sediaan.ml;
                physicalTarget = (targetAvgMg / sediaan.mg) * sediaan.ml;
                physicalUnitText = sediaan.unitName || 'mL';
            }

            // Display UI
            placeholder.classList.add('hidden');
            resultCard.classList.remove('hidden');

            document.getElementById('res-drug-category').innerText = drug.category;
            document.getElementById('res-drug-title').innerText = drug.name;

            // Form Badge
            const formBadge = document.getElementById('res-form-type-badge');
            if (sediaan.type === 'tablet') {
                formBadge.className = "text-xs bg-amber-400 text-slate-950 px-3 py-1 rounded-xl font-black shadow";
                formBadge.innerText = "SEDIAAN TABLET / PADAT";
            } else if (sediaan.type === 'drops') {
                formBadge.className = "text-xs bg-cyan-300 text-slate-950 px-3 py-1 rounded-xl font-black shadow";
                formBadge.innerText = "SEDIAAN DROPS / TETES";
            } else {
                formBadge.className = "text-xs bg-emerald-300 text-slate-950 px-3 py-1 rounded-xl font-black shadow";
                formBadge.innerText = "SEDIAAN SIRUP / CAIR";
            }

            // Automatic Signa String
            let amountString = '';
            if (sediaan.type === 'tablet') {
                amountString = formatTabletQuantity(physicalTarget);
            } else if (sediaan.unitName === 'mL') {
                amountString = `${formatNum(physicalTarget)} mL ${formatSpoonEquivalent(physicalTarget)}`;
            } else {
                amountString = `${formatNum(physicalTarget)} ${physicalUnitText}`;
            }

            document.getElementById('res-signa-auto').innerText = `${drug.freqTimes} x sehari ${amountString}`;
            document.getElementById('res-sediaan-desc').innerText = `Sediaan: ${sediaan.label} | Frekuensi: ${drug.freqText}`;

            // Physical & Mg details
            if (sediaan.type === 'tablet') {
                document.getElementById('res-physical-amount').innerText = formatTabletQuantity(physicalTarget);
                document.getElementById('res-physical-range').innerText = `Rentang: ${formatTabletQuantity(physicalMin)} - ${formatTabletQuantity(physicalMax)}`;
            } else if (sediaan.unitName === 'mL') {
                document.getElementById('res-physical-amount').innerText = `${formatNum(physicalTarget)} mL ${formatSpoonEquivalent(physicalTarget)}`;
                document.getElementById('res-physical-range').innerText = `Rentang: ${formatNum(physicalMin)} - ${formatNum(physicalMax)} mL`;
            } else {
                document.getElementById('res-physical-amount').innerText = `${formatNum(physicalTarget)} ${physicalUnitText}`;
                document.getElementById('res-physical-range').innerText = `Rentang: ${formatNum(physicalMin)} - ${formatNum(physicalMax)} ${physicalUnitText}`;
            }

            if (drug.doseMin === drug.doseMax) {
                document.getElementById('res-mg-per-dose').innerText = `${formatNum(minMg)} mg`;
                document.getElementById('res-mg-range').innerText = `Dosis tepat per kali`;
            } else {
                document.getElementById('res-mg-per-dose').innerText = `${formatNum(targetAvgMg)} mg`;
                document.getElementById('res-mg-range').innerText = `Rentang: ${formatNum(minMg)} - ${formatNum(maxMg)} mg`;
            }

            // Daily mg
            const dailyMin = minMg * drug.freqTimes;
            const dailyMax = maxMg * drug.freqTimes;
            document.getElementById('res-daily-mg').innerText = drug.doseMin === drug.doseMax
                ? `~ ${formatNum(dailyMin)} mg / hari`
                : `~ ${formatNum(dailyMin)} - ${formatNum(dailyMax)} mg / hari`;

            document.getElementById('res-notes').innerText = `${drug.notes} (Dihitung presisi BB ${weight} kg)`;
        }

        function transferSingleToPuyer() {
            const drugId = appState.single.drugId;
            const sediaanIndex = parseInt(document.getElementById('single-sediaan-select').value) || 0;

            switchTab('puyer');
            addPuyerRow({
                drugId: drugId,
                sediaanIndex: sediaanIndex
            });
        }


        // ================= LOGIKA TAB 2: RACIKAN PUYER OTOMATIS =================
        function setPuyerCountPreset(count) {
            document.getElementById('puyer-count').value = count;
            calculatePuyerAll();
        }

        function addPuyerRow(presetData = null) {
            const rowId = 'puyer-row-' + Date.now() + '-' + Math.floor(Math.random() * 1000);
            
            const defaultDrugId = presetData ? presetData.drugId : 'asam_traneksamat';
            const drug = DRUG_DATABASE.find(d => d.id === defaultDrugId) || DRUG_DATABASE[0];
            
            // Cari sediaan tablet pertama jika ada, atau sediaan teratas
            let tabletSediaanIdx = drug.sediaan.findIndex(s => s.type === 'tablet');
            if (tabletSediaanIdx === -1) tabletSediaanIdx = 0;

            const newRow = {
                id: rowId,
                drugId: defaultDrugId,
                sediaanIndex: presetData ? presetData.sediaanIndex : tabletSediaanIdx,
                targetMgPerKg: drug.doseMin,
                mgPerBungkus: 0,
                totalTabletsNeeded: 0
            };

            appState.puyer.rows.push(newRow);
            renderPuyerRows();
            calculatePuyerAll();
        }

        function removePuyerRow(rowId) {
            appState.puyer.rows = appState.puyer.rows.filter(r => r.id !== rowId);
            renderPuyerRows();
            calculatePuyerAll();
        }

        function renderPuyerRows() {
            const container = document.getElementById('puyer-rows-container');
            const emptyState = document.getElementById('puyer-empty-state');
            const countBadge = document.getElementById('puyer-items-count');

            countBadge.innerText = `${appState.puyer.rows.length} Obat`;

            if (appState.puyer.rows.length === 0) {
                container.innerHTML = '';
                emptyState.classList.remove('hidden');
                return;
            }

            emptyState.classList.add('hidden');
            container.innerHTML = '';

            appState.puyer.rows.forEach((row, idx) => {
                const drug = DRUG_DATABASE.find(d => d.id === row.drugId) || DRUG_DATABASE[0];

                const rowEl = document.createElement('div');
                rowEl.className = "bg-slate-50 border border-slate-200 rounded-xl p-3.5 sm:p-4 space-y-3 relative group transition hover:border-teal-300 hover:shadow-sm";

                // Build Drug Options
                let drugOptionsHtml = '';
                DRUG_DATABASE.forEach(d => {
                    const sel = d.id === row.drugId ? 'selected' : '';
                    drugOptionsHtml += `<option value="${d.id}" ${sel}>${d.name} (${d.category})</option>`;
                });

                // Build Sediaan Options (Semua sediaan obat ini)
                let sediaanOptionsHtml = '';
                drug.sediaan.forEach((s, sIdx) => {
                    const sel = sIdx === row.sediaanIndex ? 'selected' : '';
                    const icon = s.type === 'tablet' ? '💊' : '🧴';
                    sediaanOptionsHtml += `<option value="${sIdx}" ${sel}>${icon} ${s.label}</option>`;
                });

                rowEl.innerHTML = `
                    <div class="flex items-center justify-between border-b border-slate-200 pb-2">
                        <div class="flex items-center space-x-2">
                            <span class="w-5 h-5 rounded-full bg-teal-700 text-white text-[10px] font-extrabold flex items-center justify-center">${idx + 1}</span>
                            <span class="text-xs font-bold text-slate-800">Komponen Racikan #${idx + 1}</span>
                        </div>
                        <button type="button" onclick="removePuyerRow('${row.id}')" class="text-slate-400 hover:text-rose-600 text-xs font-semibold px-2 py-1 rounded transition">
                            <i class="fa-solid fa-trash-can mr-1"></i> Hapus
                        </button>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-12 gap-3 items-end">
                        
                        <!-- Select Drug -->
                        <div class="sm:col-span-5">
                            <label class="block text-[11px] font-semibold text-slate-600 mb-1">Nama Obat Database</label>
                            <select onchange="onPuyerRowDrugChange('${row.id}', this.value)" class="w-full px-3 py-2 bg-white border border-slate-200 rounded-lg text-xs font-bold text-slate-800 focus:ring-2 focus:ring-teal-500">
                                ${drugOptionsHtml}
                            </select>
                        </div>

                        <!-- Select Sediaan Utuh -->
                        <div class="sm:col-span-4">
                            <label class="block text-[11px] font-semibold text-slate-600 mb-1">Sediaan Tablet/Kapsul Utuh</label>
                            <select onchange="onPuyerRowSediaanChange('${row.id}', parseInt(this.value))" class="w-full px-3 py-2 bg-white border border-slate-200 rounded-lg text-xs font-semibold focus:ring-2 focus:ring-teal-500">
                                ${sediaanOptionsHtml}
                            </select>
                        </div>

                        <!-- Target Mg / kgBB -->
                        <div class="sm:col-span-3">
                            <label class="block text-[11px] font-semibold text-slate-600 mb-1">Target Dosis (mg/kg/dosis)</label>
                            <input type="number" step="0.1" value="${row.targetMgPerKg}" 
                                oninput="updateRowData('${row.id}', 'targetMgPerKg', parseFloat(this.value) || 0)"
                                class="w-full px-3 py-2 bg-white border border-slate-200 rounded-lg text-xs font-extrabold text-teal-800 focus:ring-2 focus:ring-teal-500">
                        </div>
                    </div>

                    <!-- CALCULATION DISPLAY FOR THIS ROW -->
                    <div id="row-calc-${row.id}" class="bg-teal-50/80 rounded-lg p-2.5 border border-teal-100 flex flex-wrap justify-between items-center text-xs gap-2">
                        <span class="text-slate-600">Dosis per Bungkus: <strong class="text-slate-800" id="row-mg-pack-${row.id}">- mg</strong></span>
                        <span class="text-slate-600">Total mg Racikan: <strong class="text-slate-800" id="row-total-mg-${row.id}">- mg</strong></span>
                        <span class="text-teal-900 font-extrabold bg-white px-3 py-1 rounded-md border border-teal-200 shadow-sm" id="row-tablets-${row.id}">= 0 Tablet</span>
                    </div>
                `;

                container.appendChild(rowEl);
            });
        }

        function onPuyerRowDrugChange(rowId, newDrugId) {
            const row = appState.puyer.rows.find(r => r.id === rowId);
            if (!row) return;

            const drug = DRUG_DATABASE.find(d => d.id === newDrugId);
            if (!drug) return;

            row.drugId = newDrugId;
            let tabIdx = drug.sediaan.findIndex(s => s.type === 'tablet');
            row.sediaanIndex = tabIdx !== -1 ? tabIdx : 0;
            row.targetMgPerKg = drug.doseMin;

            renderPuyerRows();
            calculatePuyerAll();
        }

        function onPuyerRowSediaanChange(rowId, newSediaanIndex) {
            const row = appState.puyer.rows.find(r => r.id === rowId);
            if (!row) return;

            row.sediaanIndex = newSediaanIndex;
            calculatePuyerAll();
        }

        function updateRowData(rowId, field, val) {
            const row = appState.puyer.rows.find(r => r.id === rowId);
            if (!row) return;

            row[field] = val;
            calculatePuyerAll();
        }

        function calculatePuyerAll() {
            const puyerCount = parseInt(document.getElementById('puyer-count').value) || 10;
            appState.puyer.count = puyerCount;
            const weight = appState.weight;

            appState.puyer.rows.forEach(row => {
                const drug = DRUG_DATABASE.find(d => d.id === row.drugId) || DRUG_DATABASE[0];
                const sediaan = drug.sediaan[row.sediaanIndex] || drug.sediaan[0];

                const mgPerBungkus = weight * row.targetMgPerKg;
                const totalMgRacikan = mgPerBungkus * puyerCount;
                const totalTabletsNeeded = sediaan.mg > 0 ? (totalMgRacikan / sediaan.mg) : 0;

                row.mgPerBungkus = mgPerBungkus;
                row.totalMgRacikan = totalMgRacikan;
                row.totalTabletsNeeded = totalTabletsNeeded;

                // Update UI Row Elements
                const elMgPack = document.getElementById(`row-mg-pack-${row.id}`);
                const elTotalMg = document.getElementById(`row-total-mg-${row.id}`);
                const elTablets = document.getElementById(`row-tablets-${row.id}`);

                if (elMgPack) elMgPack.innerText = `${formatNum(mgPerBungkus)} mg`;
                if (elTotalMg) elTotalMg.innerText = `${formatNum(totalMgRacikan)} mg`;
                if (elTablets) elTablets.innerText = `= ${formatTabletQuantity(totalTabletsNeeded)}`;
            });

            updatePrescriptionSummary();
        }

        function updatePrescriptionSummary() {
            const patientName = appState.patientName || "An. Tanpa Nama";
            const weight = appState.weight || 0;
            const puyerCount = appState.puyer.count || 10;
            const signa = document.getElementById('puyer-signa').value || "-";

            document.getElementById('summary-patient-name').innerText = patientName;
            document.getElementById('summary-patient-weight').innerText = `${weight} kg`;
            document.getElementById('summary-puyer-count').innerText = `${puyerCount} Bungkus`;
            document.getElementById('summary-signa').innerText = signa;

            const tableBody = document.getElementById('summary-table-body');
            tableBody.innerHTML = '';

            if (appState.puyer.rows.length === 0) {
                tableBody.innerHTML = `<tr><td colspan="5" class="py-4 text-center text-slate-400">Belum ada komponen obat dalam racikan puyer.</td></tr>`;
                return;
            }

            appState.puyer.rows.forEach((row, idx) => {
                const drug = DRUG_DATABASE.find(d => d.id === row.drugId) || DRUG_DATABASE[0];
                const sediaan = drug.sediaan[row.sediaanIndex] || drug.sediaan[0];

                const tr = document.createElement('tr');
                tr.className = "hover:bg-slate-100/50 transition";
                tr.innerHTML = `
                    <td class="py-2 px-2 font-semibold text-slate-500">${idx + 1}</td>
                    <td class="py-2 px-2 font-bold text-slate-800">${drug.name}</td>
                    <td class="py-2 px-2 text-slate-600">${sediaan.label}</td>
                    <td class="py-2 px-2 text-slate-600">${formatNum(row.mgPerBungkus || 0)} mg</td>
                    <td class="py-2 px-2 font-black text-teal-800 text-right">${formatTabletQuantity(row.totalTabletsNeeded || 0)}</td>
                `;
                tableBody.appendChild(tr);
            });
        }

        function updateDateInPrescription() {
            const today = new Date();
            const dd = String(today.getDate()).padStart(2, '0');
            const mm = String(today.getMonth() + 1).padStart(2, '0');
            const yyyy = today.getFullYear();
            document.getElementById('summary-date').innerText = `${dd}/${mm}/${yyyy}`;
        }

        function triggerPrintPrescription() {
            window.print();
        }

        // ================= HELPER FORMATTERS =================
        function formatNum(num) {
            if (isNaN(num) || num === 0) return '0';
            return Math.round(num * 100) / 100;
        }

        /**
         * Konversi mL ke takaran sendok teh (cth / 5 mL)
         */
        function formatSpoonEquivalent(ml) {
            if (isNaN(ml) || ml <= 0) return '';
            const cth = ml / 5;
            if (Math.abs(cth - 0.25) < 0.05) return '(¼ cth)';
            if (Math.abs(cth - 0.5) < 0.05) return '(½ cth)';
            if (Math.abs(cth - 0.75) < 0.05) return '(¾ cth)';
            if (Math.abs(cth - 1.0) < 0.05) return '(1 cth / sdt)';
            if (Math.abs(cth - 1.5) < 0.05) return '(1 ½ cth)';
            if (Math.abs(cth - 2.0) < 0.05) return '(2 cth)';
            return `(~${formatNum(cth)} cth)`;
        }

        /**
         * Mengubah desimal tablet menjadi pecahan medis yang intuitif
         */
        function formatTabletQuantity(val) {
            if (isNaN(val) || val <= 0) return '0 Tablet';

            const intPart = Math.floor(val);
            const fracPart = val - intPart;

            let fracSymbol = '';
            if (fracPart >= 0.875) return `${intPart + 1} Tablet`;
            else if (fracPart >= 0.70) fracSymbol = '¾';
            else if (fracPart >= 0.60) fracSymbol = '⅔';
            else if (fracPart >= 0.40) fracSymbol = '½';
            else if (fracPart >= 0.28) fracSymbol = '⅓';
            else if (fracPart >= 0.15) fracSymbol = '¼';

            const decFormatted = (Math.round(val * 100) / 100).toString();

            if (fracSymbol) {
                if (intPart === 0) return `${fracSymbol} Tablet (${decFormatted} Tab)`;
                return `${intPart} ${fracSymbol} Tablet (${decFormatted} Tab)`;
            }
            return `${decFormatted} Tablet`;
        }
    </script>
</body>
