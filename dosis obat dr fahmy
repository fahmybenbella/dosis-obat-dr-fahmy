<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kalkulator Dosis Obat Anak & Racikan Puyer Otomatis</title>
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome 6 CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <!-- Google Fonts: Plus Jakarta Sans -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                    },
                    colors: {
                        medical: {
                            50: '#f0fdfa',
                            100: '#ccfbf1',
                            200: '#99f6e4',
                            500: '#14b8a6',
                            600: '#0d9488',
                            700: '#0f766e',
                            800: '#115e59',
                            900: '#134e4a',
                        }
                    }
                }
            }
        }
    </script>

    <style>
        /* Sembunyikan tombol spin pada input number */
        input[type="number"]::-webkit-outer-spin-button,
        input[type="number"]::-webkit-inner-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }
        input[type="number"] {
            -moz-appearance: textfield;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f5f9;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 9999px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }

        /* Print Media Styles */
        @media print {
            .no-print {
                display: none !important;
            }
            body {
                background: white !important;
                color: black !important;
                padding: 0 !important;
            }
            .print-card {
                box-shadow: none !important;
                border: 1px solid #000 !important;
                border-radius: 8px !important;
                padding: 15px !important;
                margin: 0 !important;
                width: 100% !important;
            }
        }
    </style>
</head>
<body class="bg-slate-100 font-sans text-slate-800 antialiased min-h-screen pb-12">

    <!-- TOP HEADER -->
    <header class="bg-gradient-to-r from-teal-800 via-teal-700 to-cyan-800 text-white shadow-lg no-print">
        <div class="max-w-6xl mx-auto px-4 py-4 sm:px-6 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="w-10 h-10 rounded-xl bg-white/20 backdrop-blur flex items-center justify-center text-white text-xl shadow-inner">
                    <i class="fa-solid fa-laptop-medical"></i>
                </div>
                <div>
                    <h1 class="font-extrabold text-lg sm:text-xl tracking-tight leading-tight">PediatriDose Pro <span class="text-xs bg-teal-300/30 text-teal-100 font-normal px-2 py-0.5 rounded-full border border-teal-200/20">v3.5 Complete</span></h1>
                    <p class="text-xs text-teal-100/90 hidden sm:block">Kalkulator Dosis Obat Anak & Pembuat Racikan Puyer Indonesia</p>
                </div>
            </div>
            <div class="flex items-center space-x-2 text-xs bg-white/10 backdrop-blur px-3 py-1.5 rounded-xl border border-white/20">
                <i class="fa-solid fa-circle-check text-emerald-300"></i>
                <span class="font-medium hidden sm:inline">>45 Database Obat Terverifikasi</span>
                <span class="sm:hidden">Pediatri ID</span>
            </div>
        </div>
    </header>

    <!-- MAIN CONTAINER -->
    <main class="max-w-6xl mx-auto px-3 sm:px-6 mt-4 sm:mt-6 space-y-5">

        <!-- GLOBAL PASIEN & BERAT BADAN HEADER -->
        <section class="bg-white rounded-2xl p-4 sm:p-5 shadow-sm border border-slate-200/80 no-print">
            <div class="flex items-center justify-between mb-3 border-b border-slate-100 pb-2">
                <div class="flex items-center space-x-2 text-teal-700 font-bold text-sm sm:text-base">
                    <i class="fa-solid fa-user-nurse"></i>
                    <span>Informasi Pasien & Berat Badan (Kalkulasi Otomatis)</span>
                </div>
                <span class="text-xs text-teal-600 bg-teal-50 px-2.5 py-1 rounded-full font-semibold">Tersinkron Otomatis</span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <!-- Nama Pasien -->
                <div>
                    <label for="global-patient-name" class="block text-xs font-semibold text-slate-600 mb-1">Nama Pasien / Anak</label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-slate-400">
                            <i class="fa-solid fa-child"></i>
                        </span>
                        <input type="text" id="global-patient-name" placeholder="Misal: An. Budi" 
                            class="w-full pl-9 pr-3 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-teal-500 focus:bg-white transition">
                    </div>
                </div>

                <!-- Berat Badan -->
                <div>
                    <label for="global-weight" class="block text-xs font-semibold text-slate-600 mb-1">
                        Berat Badan (BB) <span class="text-rose-500">*Input Utama</span>
                    </label>
                    <div class="flex items-center space-x-2">
                        <div class="relative flex-1">
                            <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-teal-600 font-bold">
                                <i class="fa-solid fa-weight-scale"></i>
                            </span>
                            <input type="number" id="global-weight" step="0.5" min="1" max="100" placeholder="10" 
                                class="w-full pl-9 pr-12 py-2.5 bg-teal-50/50 border border-teal-200 rounded-xl text-base font-extrabold text-teal-900 focus:outline-none focus:ring-2 focus:ring-teal-500 focus:bg-white transition">
                            <span class="absolute inset-y-0 right-0 pr-3 flex items-center text-xs font-bold text-teal-600">kg</span>
                        </div>

                        <!-- Stepper BB (+/- 0.5 kg) -->
                        <div class="flex items-center space-x-1">
                            <button type="button" onclick="adjustWeight(-0.5)" class="w-10 h-10 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl font-bold flex items-center justify-center transition border border-slate-200 active:scale-95 shadow-sm" title="Kurang 0.5 kg">
                                <i class="fa-solid fa-minus text-xs"></i>
                            </button>
                            <button type="button" onclick="adjustWeight(0.5)" class="w-10 h-10 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl font-bold flex items-center justify-center transition border border-slate-200 active:scale-95 shadow-sm" title="Tambah 0.5 kg">
                                <i class="fa-solid fa-plus text-xs"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Preset BB Cepat -->
            <div class="mt-3 flex items-center space-x-2 overflow-x-auto pt-1 pb-0.5">
                <span class="text-[11px] text-slate-400 font-medium whitespace-nowrap mr-1">Preset BB Cepat:</span>
                <button type="button" onclick="setWeightPreset(5)" class="px-3 py-1 bg-slate-100 hover:bg-teal-50 hover:text-teal-700 border border-slate-200 rounded-lg text-xs font-semibold text-slate-600 transition">5 kg</button>
                <button type="button" onclick="setWeightPreset(8)" class="px-3 py-1 bg-slate-100 hover:bg-teal-50 hover:text-teal-700 border border-slate-200 rounded-lg text-xs font-semibold text-slate-600 transition">8 kg</button>
                <button type="button" onclick="setWeightPreset(10)" class="px-3 py-1 bg-slate-100 hover:bg-teal-50 hover:text-teal-700 border border-slate-200 rounded-lg text-xs font-semibold text-slate-600 transition">10 kg</button>
                <button type="button" onclick="setWeightPreset(12.5)" class="px-3 py-1 bg-slate-100 hover:bg-teal-50 hover:text-teal-700 border border-slate-200 rounded-lg text-xs font-semibold text-slate-600 transition">12.5 kg</button>
                <button type="button" onclick="setWeightPreset(15)" class="px-3 py-1 bg-slate-100 hover:bg-teal-50 hover:text-teal-700 border border-slate-200 rounded-lg text-xs font-semibold text-slate-600 transition">15 kg</button>
                <button type="button" onclick="setWeightPreset(20)" class="px-3 py-1 bg-slate-100 hover:bg-teal-50 hover:text-teal-700 border border-slate-200 rounded-lg text-xs font-semibold text-slate-600 transition">20 kg</button>
                <button type="button" onclick="setWeightPreset(25)" class="px-3 py-1 bg-slate-100 hover:bg-teal-50 hover:text-teal-700 border border-slate-200 rounded-lg text-xs font-semibold text-slate-600 transition">25 kg</button>
            </div>
        </section>

        <!-- NAVIGATION TABS -->
        <div class="bg-slate-200/80 p-1.5 rounded-2xl flex space-x-1 no-print shadow-inner">
            <button id="btn-tab-1" onclick="switchTab('single')" class="flex-1 py-3 px-3 rounded-xl font-bold text-xs sm:text-sm flex items-center justify-center space-x-2 transition-all duration-200 bg-white text-teal-800 shadow-sm">
                <i class="fa-solid fa-calculator"></i>
                <span class="truncate">Dosis Tunggal Otomatis (Tablet/Sirup)</span>
            </button>
            <button id="btn-tab-2" onclick="switchTab('puyer')" class="flex-1 py-3 px-3 rounded-xl font-bold text-xs sm:text-sm flex items-center justify-center space-x-2 transition-all duration-200 text-slate-600 hover:text-slate-900">
                <i class="fa-solid fa-mortar-pestle"></i>
                <span class="truncate">Racikan Puyer Otomatis (Compounding)</span>
            </button>
        </div>

        <!-- ================= TAB 1: DOSIS TUNGGAL OTOMATIS ================= -->
        <div id="tab-single" class="space-y-5 no-print">
            
            <!-- FILTER KATEGORI OBAT -->
            <div class="bg-white rounded-2xl p-4 shadow-sm border border-slate-200/80 space-y-2">
                <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider">Filter Kategori Obat:</label>
                <div id="category-filter-container" class="flex flex-wrap gap-1.5 text-xs">
                    <!-- Dynamic Buttons -->
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-5">
                
                <!-- INPUT PANEL -->
                <div class="lg:col-span-5 bg-white rounded-2xl p-5 shadow-sm border border-slate-200 space-y-4">
                    <div class="flex items-center space-x-2 text-teal-700 font-bold border-b border-slate-100 pb-2">
                        <i class="fa-solid fa-pills"></i>
                        <h2>Pilih Obat & Sediaan</h2>
                    </div>

                    <!-- Pencarian Nama Obat -->
                    <div>
                        <label for="drug-search" class="block text-xs font-semibold text-slate-600 mb-1">Cari Obat</label>
                        <div class="relative">
                            <input type="text" id="drug-search" placeholder="Ketik nama obat (Cth: Asam Traneksamat, Azithromycin)..." 
                                oninput="filterDrugDropdown()"
                                class="w-full pl-9 pr-8 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-teal-500 focus:bg-white transition">
                            <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-slate-400">
                                <i class="fa-solid fa-magnifying-glass"></i>
                            </span>
                            <button id="clear-search-btn" onclick="clearDrugSearch()" class="hidden absolute inset-y-0 right-0 pr-3 flex items-center text-slate-400 hover:text-slate-600">
                                <i class="fa-solid fa-xmark"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Dropdown Select Obat -->
                    <div>
                        <label for="single-drug-select" class="block text-xs font-semibold text-slate-600 mb-1">Nama Obat (>40 Database Indonesia)</label>
                        <select id="single-drug-select" onchange="onSingleDrugSelect()" class="w-full py-2.5 px-3 bg-slate-50 border border-slate-200 rounded-xl text-sm font-semibold focus:outline-none focus:ring-2 focus:ring-teal-500 focus:bg-white transition">
                            <!-- Populated by JS -->
                        </select>
                    </div>

                    <!-- Dropdown Select Sediaan (Tablet / Sirup / Drops / Dry Syrup) -->
                    <div>
                        <label for="single-sediaan-select" class="block text-xs font-semibold text-slate-600 mb-1">Bentuk & Sediaan Obat</label>
                        <select id="single-sediaan-select" onchange="calculateSingleDose()" class="w-full py-2.5 px-3 bg-slate-50 border border-slate-200 rounded-xl text-sm font-bold text-teal-900 focus:outline-none focus:ring-2 focus:ring-teal-500 focus:bg-white transition">
                            <!-- Populated by JS -->
                        </select>
                    </div>

                    <!-- Info Parameter Dosis Terstandar (Readonly) -->
                    <div class="p-3 bg-slate-50 rounded-xl border border-slate-200 text-xs space-y-1">
                        <div class="flex justify-between">
                            <span class="text-slate-500">Standar Dosis Sistem:</span>
                            <strong id="info-dose-std" class="text-slate-800">-</strong>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-slate-500">Frekuensi Pemberian:</span>
                            <strong id="info-freq-std" class="text-slate-800">-</strong>
                        </div>
                    </div>
                </div>

                <!-- HASIL KALKULASI OTOMATIS PANEL -->
                <div class="lg:col-span-7 space-y-4">
                    
                    <!-- Placeholder -->
                    <div id="single-placeholder" class="bg-white rounded-2xl p-8 shadow-sm border border-slate-200 text-center flex flex-col items-center justify-center min-h-[320px]">
                        <div class="w-16 h-16 bg-teal-50 text-teal-600 rounded-full flex items-center justify-center text-2xl mb-3">
                            <i class="fa-solid fa-calculator"></i>
                        </div>
                        <h3 class="font-bold text-slate-700 text-base">Perhitungan Dosis Otomatis</h3>
                        <p class="text-xs text-slate-400 max-w-xs mt-1">Masukkan Berat Badan (BB) dan pilih Nama Obat untuk melihat hasil dosis presisi secara otomatis.</p>
                    </div>

                    <!-- CARD HASIL KALKULASI UTAMA -->
                    <div id="single-result-card" class="hidden bg-gradient-to-br from-teal-900 via-teal-800 to-slate-900 text-white rounded-2xl p-5 shadow-xl space-y-4 relative overflow-hidden">
                        
                        <i class="fa-solid fa-prescription-bottle-medical text-white/5 text-9xl absolute -right-4 -bottom-4 pointer-events-none"></i>

                        <div class="flex items-center justify-between border-b border-teal-700/60 pb-3">
                            <div>
                                <span id="res-drug-category" class="text-[10px] bg-teal-400/20 text-teal-200 border border-teal-300/30 px-2.5 py-0.5 rounded-full font-bold uppercase tracking-wider">Kategori</span>
                                <h3 id="res-drug-title" class="text-xl font-extrabold text-white leading-tight mt-1">-</h3>
                            </div>
                            <span id="res-form-type-badge" class="text-xs bg-amber-400 text-slate-950 px-3 py-1 rounded-xl font-black shadow">TABLET</span>
                        </div>

                        <!-- HIGHLIGHT ATURAN MINUM OTOMATIS -->
                        <div class="bg-white/10 backdrop-blur border border-white/15 rounded-xl p-4 space-y-1">
                            <span class="text-xs text-teal-200 font-semibold uppercase tracking-wider block">Aturan Minum / Signa Otomatis:</span>
                            <div id="res-signa-auto" class="text-lg sm:text-2xl font-black text-amber-300 leading-tight">
                                3 x sehari 1/2 Tablet
                            </div>
                            <p id="res-sediaan-desc" class="text-xs text-teal-100/90 pt-1">Sediaan: Tablet 500 mg</p>
                        </div>

                        <!-- GRID HIGHLIGHT DETAIL DOSIS -->
                        <div class="grid grid-cols-2 gap-3">
                            <!-- Jumlah Fisik Minum -->
                            <div class="bg-black/20 backdrop-blur border border-white/10 rounded-xl p-3">
                                <span class="text-[11px] text-teal-200 block mb-0.5">Jumlah Fisik / Kali Minum</span>
                                <div id="res-physical-amount" class="text-lg sm:text-xl font-black text-emerald-300 leading-tight">-</div>
                                <span id="res-physical-range" class="text-[10px] text-teal-200/80 block mt-1">Rentang: -</span>
                            </div>

                            <!-- Dosis mg per kali -->
                            <div class="bg-black/20 backdrop-blur border border-white/10 rounded-xl p-3">
                                <span class="text-[11px] text-teal-200 block mb-0.5">Dosis mg / Kali Minum</span>
                                <div id="res-mg-per-dose" class="text-lg sm:text-xl font-black text-cyan-200 leading-tight">-</div>
                                <span id="res-mg-range" class="text-[10px] text-teal-200/80 block mt-1">Rentang: -</span>
                            </div>
                        </div>

                        <!-- SECONDARY INFO -->
                        <div class="bg-black/30 rounded-xl p-3.5 space-y-2 border border-white/5 text-xs">
                            <div class="flex justify-between items-center border-b border-white/10 pb-1.5">
                                <span class="text-teal-200">Total Dosis Harian (mg/hari):</span>
                                <span id="res-daily-mg" class="font-bold text-white text-right">-</span>
                            </div>
                            <div class="flex justify-between items-start pt-0.5">
                                <span class="text-teal-200">Catatan Klinis:</span>
                                <span id="res-notes" class="font-medium text-slate-200 text-right max-w-[220px] text-[11px]">-</span>
                            </div>
                        </div>

                        <!-- Tombol Transfer ke Puyer -->
                        <button type="button" onclick="transferSingleToPuyer()" class="w-full py-3 bg-teal-400 hover:bg-teal-300 text-slate-950 font-black rounded-xl text-xs transition flex items-center justify-center space-x-2 shadow-lg shadow-teal-500/20 active:scale-98">
                            <span>Jadikan Obat Ini Dalam Racikan Puyer</span>
                            <i class="fa-solid fa-arrow-right"></i>
                        </button>
                    </div>
                </div>

            </div>
        </div>

        <!-- ================= TAB 2: KALKULATOR RACIKAN PUYER OTOMATIS ================= -->
        <div id="tab-puyer" class="space-y-5 no-print hidden">
            
            <!-- HEADER PARAMETER PUYER -->
            <div class="bg-white rounded-2xl p-4 sm:p-5 shadow-sm border border-slate-200 space-y-4">
                <div class="flex items-center justify-between border-b border-slate-100 pb-2">
                    <div class="flex items-center space-x-2 text-teal-700 font-bold">
                        <i class="fa-solid fa-mortar-pestle"></i>
                        <h2>Parameter Resep Racikan Puyer</h2>
                    </div>
                    <span class="text-xs text-slate-400">Langkah Compounding</span>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label for="puyer-count" class="block text-xs font-semibold text-slate-600 mb-1">
                            Jumlah Bungkus Puyer yang Dibuat
                        </label>
                        <div class="flex items-center space-x-2">
                            <input type="number" id="puyer-count" value="10" min="1" max="100" oninput="calculatePuyerAll()" 
                                class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm font-extrabold text-slate-800 focus:outline-none focus:ring-2 focus:ring-teal-500">
                            <div class="flex space-x-1">
                                <button type="button" onclick="setPuyerCountPreset(10)" class="px-2.5 py-2 bg-slate-100 hover:bg-teal-50 hover:text-teal-700 border rounded-lg text-xs font-bold text-slate-600">10</button>
                                <button type="button" onclick="setPuyerCountPreset(12)" class="px-2.5 py-2 bg-slate-100 hover:bg-teal-50 hover:text-teal-700 border rounded-lg text-xs font-bold text-slate-600">12</button>
                                <button type="button" onclick="setPuyerCountPreset(15)" class="px-2.5 py-2 bg-slate-100 hover:bg-teal-50 hover:text-teal-700 border rounded-lg text-xs font-bold text-slate-600">15</button>
                            </div>
                        </div>
                    </div>

                    <div>
                        <label for="puyer-signa" class="block text-xs font-semibold text-slate-600 mb-1">
                            Aturan Minum (Signa)
                        </label>
                        <input type="text" id="puyer-signa" value="3 x sehari 1 bungkus (Sesudah Makan)" oninput="updatePrescriptionSummary()" 
                            class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm font-semibold focus:outline-none focus:ring-2 focus:ring-teal-500">
                    </div>
                </div>
            </div>

            <!-- TABLE MULTI OBAT PUYER -->
            <div class="bg-white rounded-2xl p-4 sm:p-5 shadow-sm border border-slate-200 space-y-4">
                <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                    <div>
                        <h3 class="font-bold text-slate-800 text-sm sm:text-base flex items-center space-x-2">
                            <span>Komponen Obat Racikan</span>
                            <span id="puyer-items-count" class="bg-teal-100 text-teal-800 text-xs px-2.5 py-0.5 rounded-full font-bold">0 Obat</span>
                        </h3>
                        <p class="text-xs text-slate-400">Pilih obat dari database, sistem akan menghitung kebutuhan tablet utuh secara otomatis.</p>
                    </div>

                    <button type="button" onclick="addPuyerRow()" class="px-3.5 py-2.5 bg-teal-600 hover:bg-teal-700 text-white rounded-xl text-xs font-bold transition flex items-center space-x-1.5 shadow-sm active:scale-95">
                        <i class="fa-solid fa-plus"></i>
                        <span>+ Tambah Obat Racikan</span>
                    </button>
                </div>

                <!-- CONTAINER ROWS PUYER -->
                <div id="puyer-rows-container" class="space-y-3">
                    <!-- Dynamic Rows -->
                </div>

                <!-- Empty State -->
                <div id="puyer-empty-state" class="py-8 text-center border-2 border-dashed border-slate-200 rounded-xl bg-slate-50/50">
                    <i class="fa-solid fa-pills text-slate-300 text-3xl mb-2 block"></i>
                    <p class="text-xs font-semibold text-slate-500">Belum ada obat dalam racikan puyer.</p>
                    <p class="text-[11px] text-slate-400 mt-0.5">Klik tombol "<span class="text-teal-600 font-bold">+ Tambah Obat Racikan</span>" di atas untuk memulai.</p>
                </div>
            </div>

            <!-- REKAPITULASI & ETIKET RESEP CARD -->
            <div id="puyer-summary-card" class="bg-white rounded-2xl p-5 shadow-md border border-teal-200/80 space-y-4">
                <div class="flex items-center justify-between border-b border-slate-200 pb-3">
                    <div class="flex items-center space-x-2">
                        <div class="w-8 h-8 rounded-lg bg-teal-100 text-teal-700 flex items-center justify-center font-bold">
                            <i class="fa-solid fa-file-prescription"></i>
                        </div>
                        <div>
                            <h3 class="font-extrabold text-slate-800 text-sm sm:text-base">Ringkasan Etiket / Resep Racikan</h3>
                            <p class="text-[11px] text-slate-400">Siap untuk penyiapan di apotek / rekam medis</p>
                        </div>
                    </div>

                    <button type="button" onclick="triggerPrintPrescription()" class="px-4 py-2 bg-slate-900 hover:bg-slate-800 text-white rounded-xl text-xs font-bold transition flex items-center space-x-2 shadow active:scale-95">
                        <i class="fa-solid fa-print"></i>
