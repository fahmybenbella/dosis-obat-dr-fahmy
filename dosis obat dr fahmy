        function adjustWeight(delta) {
            const el = document.getElementById('global-weight');
            let val = (parseFloat(el.value) || 0) + delta;
            if (val < 0) val = 0;
            el.value = Math.round(val * 10) / 10;
            appState.weight = parseFloat(el.value);
            calculateSingleDose();
            calculatePuyerAll();
            updatePrescriptionSummary();
        }

